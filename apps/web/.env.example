# KeepTend Web — Config API environment variables
#
# NEXT_PUBLIC_API_KEY   — Anthropic API key served to the mobile app as the free-tier config.
#                         Get one at https://console.anthropic.com/
# NEXT_PUBLIC_PROVIDER  — AI provider for the free tier ("Anthropic" or "OpenAI").
#                         Defaults to "Anthropic" when omitted.
#                         Anthropic models used:
#                           text   → claude-haiku-4-5-20251001  (~95% cheaper than gpt-4o)
#                           vision → claude-sonnet-4-6           (cheaper than gpt-4o, vision-capable)

NEXT_PUBLIC_API_KEY=sk-ant-...
NEXT_PUBLIC_PROVIDER=Anthropic

# KeepTend Web — AI routes (/api/ai/name, /api/ai/photo, /api/ai/chat)
#
# These are server-only. Never prefix them with NEXT_PUBLIC_, and never commit real values.
# The routes answer 500 "not configured" until AI_API_KEY and REVENUECAT_SECRET_KEY are set.
#
# AI_PROVIDER            — "Anthropic" (default) or "OpenAI". Model choice stays on the server.
# AI_API_KEY             — Key for the provider above.
# REVENUECAT_SECRET_KEY  — RevenueCat secret API key (starts with sk_). The server uses it to
#                          check the "pro" entitlement of the app user id on every request.
#                          Get one in the RevenueCat dashboard under API keys.

AI_PROVIDER=Anthropic
AI_API_KEY=sk-ant-...
REVENUECAT_SECRET_KEY=sk_...
